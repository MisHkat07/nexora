# Copy to backend/.env and fill in. Only DATABASE and JWT_SECRET are required.

# MongoDB connection string (Atlas or local replica set)
DATABASE=mongodb://127.0.0.1:27017/nexora

# Secret used to sign login and download tokens. Must be at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origins allowed to call the API from a browser, comma-separated.
# Defaults to http://localhost:3000 in development and same-origin only in production.
CORS_ORIGINS=

# Number of reverse proxies in front of the app (1 on Render). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=

PORT=8888
NODE_ENV=development

# Public base URL where uploaded files are served (used in PDFs)
PUBLIC_SERVER_FILE=http://localhost:8888/

# Resend API key for sending emails
RESEND_API=
