# Copy to backend/.env and fill in. Only DATABASE and JWT_SECRET are required.

# MongoDB connection string (Atlas or local replica set)
DATABASE=mongodb://127.0.0.1:27017/nexora

# Secret used to sign login and download tokens. Must be at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origins allowed to call the API from a browser, comma-separated.
# Defaults to http://localhost:3000 in development and same-origin only in production.
CORS_ORIGINS=

# Number of reverse proxies in front of the app (1 on Render). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=

PORT=8888
NODE_ENV=development

# Resend API key for sending emails
RESEND_API=

# ---- File storage (logos, avatars) ----
# "local" keeps uploads on disk (fine for development; lost on every Render deploy).
# "s3" uses any S3-compatible bucket: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO.
# The bucket can stay private: the app serves files itself at /public/uploads/...
# After switching to s3, copy existing uploads with: npm run storage:migrate
STORAGE_DRIVER=local
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" for R2; e.g. "us-east-1" for AWS
S3_REGION=auto
# Leave empty for AWS. R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Max upload size in bytes (default 5 MB)
UPLOAD_MAX_BYTES=

# ---- Error tracking (optional) ----
# Sentry project DSN for the backend; nothing is sent when empty
SENTRY_DSN=
# Fraction of requests to trace for performance (0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0
